    "deploy": "firebase deploy --only functions:getData,functions:getArcGISToken",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "main": "index.js",
  "dependencies": {
    "@google-cloud/secret-manager": "^7.0.0",
    "cors": "^2.8.6",
    "firebase-admin": "^14.3.0",
    "firebase-functions": "^7.3.2",
    "mysql": "^2.18.1",
    "node-fetch": "^3.3.2"
  },
  "overrides": {
    "protobufjs": "^7.6.5",
    "uuid": "^11.1.1"
  },
  "private": true
}
